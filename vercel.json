{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/warm-cache",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/deepseek-mcp",
      "destination": "/api/mcp?profile=deepseek_harness"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/guides",
      "destination": "/api/content-page?section=guides"
    },
    {
      "source": "/guides/:slug.md",
      "destination": "/api/content-page?section=guides&slug=:slug&format=markdown"
    },
    {
      "source": "/guides/:slug",
      "destination": "/api/content-page?section=guides&slug=:slug"
    },
    {
      "source": "/features",
      "destination": "/api/content-page?section=features"
    },
    {
      "source": "/features/:slug.md",
      "destination": "/api/content-page?section=features&slug=:slug&format=markdown"
    },
    {
      "source": "/features/:slug",
      "destination": "/api/content-page?section=features&slug=:slug"
    },
    {
      "source": "/articles",
      "destination": "/api/content-page?section=articles"
    },
    {
      "source": "/articles/:slug.md",
      "destination": "/api/content-page?section=articles&slug=:slug&format=markdown"
    },
    {
      "source": "/articles/:slug",
      "destination": "/api/content-page?section=articles&slug=:slug"
    },
    {
      "source": "/reference",
      "destination": "/api/content-page?section=reference"
    },
    {
      "source": "/reference/:slug.md",
      "destination": "/api/content-page?section=reference&slug=:slug&format=markdown"
    },
    {
      "source": "/reference/:slug",
      "destination": "/api/content-page?section=reference&slug=:slug"
    },
    {
      "source": "/collections",
      "destination": "/api/content-page?section=collections"
    },
    {
      "source": "/collections/:slug",
      "destination": "/api/content-page?section=collections&slug=:slug"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://acrobatic-corgi-867.convex.site/auth/:path*"
    },
    {
      "source": "/themes",
      "destination": "https://acrobatic-corgi-867.convex.site/themes"
    },
    {
      "source": "/themes/dexthemes/:subgroup",
      "destination": "/api/themes?subgroup=:subgroup&response=subgroup"
    },
    {
      "source": "/themes/:path*",
      "destination": "https://acrobatic-corgi-867.convex.site/themes/:path*"
    },
    {
      "source": "/unlocks/:path*",
      "destination": "https://acrobatic-corgi-867.convex.site/unlocks/:path*"
    },
    {
      "source": "/supporters",
      "destination": "https://acrobatic-corgi-867.convex.site/supporters"
    },
    {
      "source": "/supporters/:path*",
      "destination": "https://acrobatic-corgi-867.convex.site/supporters/:path*"
    },
    {
      "source": "/leaderboard",
      "destination": "https://acrobatic-corgi-867.convex.site/leaderboard"
    },
    {
      "source": "/me/:path*",
      "destination": "https://acrobatic-corgi-867.convex.site/me/:path*"
    },
    {
      "source": "/color-me-lucky/:path*",
      "destination": "https://acrobatic-corgi-867.convex.site/color-me-lucky/:path*"
    },
    {
      "source": "/:theme/:variant",
      "destination": "/api/share?theme=:theme&variant=:variant"
    }
  ],
  "headers": [
    {
      "source": "/dist/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.svg$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(manifest\\.json|icon-192\\.png|apple-touch-icon\\.png)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/og",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/share",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/content-page",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/api/sitemap",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/public-pages.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/themes",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/deepseek-theme",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
