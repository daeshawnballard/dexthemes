{
  "name": "@dexthemes/deepseek-harness-plugin",
  "version": "0.5.0",
  "description": "Installed DexThemes browser plugin for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daeshawnballard/dexthemes.git",
    "directory": "packages/deepseek-harness-plugin"
  },
  "homepage": "https://www.dexthemes.com",
  "bugs": {
    "url": "https://github.com/daeshawnballard/dexthemes/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dexthemes",
    "theme",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@statsig/js-client": "^3.32.2"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
